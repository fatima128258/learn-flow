{
  "name": "learnflow-root",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --prefix ./apps/web run dev",
    "build": "npm --prefix ./apps/web run build",
    "start": "npm --prefix ./apps/web run start",
    "lint": "npm run lint --workspaces --if-present",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "prisma": {
    "seed": "node apps\\api\\prisma\\seed.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "typescript-eslint": "^8.68.0",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true
  },
  "dependencies": {
    "nodemailer": "^10.0.10"
  },
  "overrides": {
    "body-parser": "1.20.8",
    "qs": "6.16.0",
    "tar": "7.5.22"
  }
}
