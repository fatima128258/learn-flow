# Example environment variables for LearnFlow
# Do NOT put real secrets here. Use a secure secret manager in production.
#
# NETWORKING NOTE:
# - For local development (running API/web directly on host): use localhost for all services
# - For Docker Compose: use service names (db, redis, mailpit, minio, meilisearch)
#   The docker-compose.yml provides the correct internal URLs automatically.

# Postgres
POSTGRES_USER=learnflow
POSTGRES_PASSWORD=learnflow_pass
POSTGRES_DB=learnflow_db
# Connection string for Prisma and other services.
# Local development: postgresql://learnflow:learnflow_pass@localhost:5432/learnflow_db?schema=public
# Docker Compose (provided automatically): postgresql://learnflow:learnflow_pass@db:5432/learnflow_db?schema=public
DATABASE_URL=postgresql://learnflow:learnflow_pass@localhost:5432/learnflow_db?schema=public

# Redis
# Local development: redis://localhost:6379
# Docker Compose (provided automatically): redis://redis:6379
REDIS_URL=redis://localhost:6379

# Mailpit (SMTP for development)
# Local development: localhost
# Docker Compose (provided automatically): mailpit
MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=1025
MAIL_FROM=no-reply@learnflow.local

# App URL (for email links)
APP_URL=http://localhost:3000

# Session configuration
SESSION_COOKIE_NAME=learnflow_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=604800

# Seeded Platform Admin (local development only — do not commit real secrets)
# Defaults used when a fresh database is reset + seeded.
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin123

# Object storage (Cloudinary)
# Credentials come from the Cloudinary dashboard (Account -> API Keys -> New API Key).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Meilisearch (search engine)
# Local development: MEILISEARCH_HOST=http://localhost:7700
# Docker Compose (provided automatically): MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=masterKey
