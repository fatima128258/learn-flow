{
  "name": "learnflow-api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "node prisma/seed.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@learnflow/validation": "file:../../packages/validation",
    "@prisma/client": "^4.16.2",
    "argon2": "^0.30.3",
    "bullmq": "^6.3.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "ioredis": "5.3.2",
    "minio": "^8.0.7",
    "multer": "^2.2.0",
    "nodemailer": "^6.9.8",
    "pdfkit": "^0.20.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.17",
    "@types/multer": "^2.2.0",
    "@types/nodemailer": "^6.4.14",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^2.0.12",
    "prisma": "^4.16.1",
    "supertest": "^6.3.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5",
    "vitest": "^1.0.0"
  }
