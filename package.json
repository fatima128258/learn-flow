{
  "name": "learnflow-root",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --prefix ./apps/web run dev",
    "build": "npm --prefix ./apps/web run build",
    "start": "npm --prefix ./apps/web run start",
    "lint": "npm run lint --workspaces --if-present",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "prisma": {
    "seed": "node apps\\api\\prisma\\seed.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "^1.6.1",
    "eslint": "^9",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "^5",
    "typescript-eslint": "^8.68.0",
    "vitest": "^1.0.0"
  }
}
